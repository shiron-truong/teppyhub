# --- target / flash / PSRAM (ESP32-S3-WROOM-1-N16R8: 16 MB quad flash, 8 MB octal PSRAM) ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_singleapp_large.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- FreeRTOS / tasks ---
# 100 Hz made pdMS_TO_TICKS(<10 ms) == 0 (busy loops in the BLE code, 10 ms LVGL granularity).
CONFIG_FREERTOS_HZ=1000
# app_main builds the whole UI: 3.5 KB was far too small.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# --- RGB LCD + LVGL port (Waveshare component) ---
CONFIG_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
CONFIG_LVGL_PORT_BUF_PSRAM=y
CONFIG_LVGL_PORT_BUF_INTERNAL=n
CONFIG_LVGL_PORT_BUF_HEIGHT=40
CONFIG_LVGL_PORT_AVOID_TEAR_ENABLE=n
CONFIG_LVGL_PORT_TASK_MIN_DELAY_MS=1
CONFIG_LVGL_PORT_TASK_STACK_SIZE_KB=16
CONFIG_LVGL_PORT_TASK_CORE=1

# --- LVGL ---
# The default 32 KB static pool is exhausted by the Tiny-TTF glyph caches + 3 pages of widgets.
# Use malloc (PSRAM for big blocks) instead.
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_SLIDER=y
CONFIG_LV_USE_SWITCH=y

# --- Bluetooth: NimBLE, peripheral (GATT server "WazeHUD") ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
